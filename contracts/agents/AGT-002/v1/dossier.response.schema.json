{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psi:siio:agents:agt002:v1:dossier.response",
  "title": "agt002.dossier.read response",
  "description": "Read-only SIIO contract over the named canonical producer; no effects are authorized.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "capability_id": {
      "const": "agt002.dossier.read"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{4,127}$"
    },
    "policy_version": {
      "const": "phase3a-p1-read-only"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "const": "SIIO"
        },
        "dataset": {
          "const": "psi_sales_interactions"
        },
        "record_set_id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{4,127}$"
        },
        "persisted": {
          "const": true
        }
      },
      "required": [
        "system",
        "dataset",
        "record_set_id",
        "persisted"
      ]
    },
    "cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 5,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{4,127}$"
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "record_set",
              "record",
              "analysis",
              "policy"
            ]
          },
          "record_id": {
            "type": "string",
            "minLength": 5,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{4,127}$"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "evidence_id",
          "evidence_type",
          "record_id",
          "captured_at"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dossier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "opportunity_id": {
              "type": "string",
              "minLength": 5,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{4,127}$"
            },
            "document_count": {
              "type": "integer",
              "minimum": 0
            },
            "missing_document_count": {
              "type": "integer",
              "minimum": 0
            },
            "analysis_status": {
              "type": "string",
              "enum": [
                "available",
                "not_available",
                "stale_or_failed"
              ]
            },
            "human_pending_count": {
              "type": "integer",
              "minimum": 0
            },
            "dossier_status": {
              "type": "string",
              "enum": [
                "available",
                "partial",
                "unavailable"
              ]
            }
          },
          "required": [
            "opportunity_id",
            "document_count",
            "missing_document_count",
            "analysis_status",
            "human_pending_count",
            "dossier_status"
          ]
        }
      },
      "required": [
        "dossier"
      ]
    }
  },
  "required": [
    "contract_version",
    "capability_id",
    "correlation_id",
    "run_id",
    "policy_version",
    "source",
    "cutoff_at",
    "evidence",
    "data"
  ]
}
