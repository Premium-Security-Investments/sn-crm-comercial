{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psi:siio:agents:agt002:v2-draft:analysis-run.request",
  "title": "AGT-002 tender analysis snapshot",
  "description": "Closed SIIO snapshot consumed by the provider-neutral AGT-002 analysis boundary.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "snapshot_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "opportunity_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "tender_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "document_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profile_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "document_type": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "current": { "type": "boolean" }
        },
        "required": ["document_id", "name", "document_type", "content", "content_sha256", "current"]
      }
    },
    "company_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_version": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "value": { "type": "string" },
              "source": { "type": ["string", "null"] }
            },
            "required": ["key", "label", "value", "source"]
          }
        }
      },
      "required": ["profile_version", "fields"]
    }
  },
  "required": ["snapshot_id", "opportunity_id", "tender_id", "document_hash", "profile_hash", "documents", "company_profile"]
}
