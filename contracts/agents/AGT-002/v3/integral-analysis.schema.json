{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psi:siio:agents:agt002:v3:integral-analysis",
  "title": "AGT-002 v3 integral_analysis payload",
  "description": "The inner governed integral_analysis object. Mirrors validateAgt002IntegralAnalysisV3 and the closed key/enum sets in agt002-integral-analysis-v3.js. contract_version, coverage and each unit's category/evidence_state are SERVER-owned (the model turn writes null for category/evidence_state).",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "coverage", "analysis_units"],
  "properties": {
    "contract_version": { "const": "agt002-integral-analysis-v3" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_version", "expected_requirement_ids", "analyzed_requirement_ids", "material_omissions",
        "omission_reasons", "company_evidence_manifest_version", "company_evidence_class_ids", "legal_corpus_version_id"
      ],
      "properties": {
        "manifest_version": { "type": "string" },
        "expected_requirement_ids": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
        "analyzed_requirement_ids": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
        "material_omissions": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
        "omission_reasons": { "type": "array" },
        "company_evidence_manifest_version": { "type": "string" },
        "company_evidence_class_ids": { "type": "array", "items": { "type": "string" } },
        "legal_corpus_version_id": { "type": ["string", "null"] }
      }
    },
    "analysis_units": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/unit" }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id", "unit_kind", "requirement_id", "category", "sequence", "title", "assessment_mode",
        "conclusion", "blocking", "evidence_state", "evidence_refs", "missing_evidence", "commercial_impact",
        "legal_assessment", "actions", "milestone", "escalation", "closure", "human_validation"
      ],
      "properties": {
        "unit_id": { "type": "string", "maxLength": 120 },
        "unit_kind": { "enum": ["tender_requirement", "strategic_consideration"] },
        "requirement_id": { "type": ["string", "null"], "maxLength": 120 },
        "category": { "type": ["string", "null"], "enum": ["discard", "habilitating", "technical", "financial_execution", "strategic", null] },
        "sequence": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "maxLength": 200 },
        "assessment_mode": { "enum": ["assessed", "abstained"] },
        "conclusion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "summary", "confidence"],
          "properties": {
            "status": { "enum": ["supported_with_evidence", "partially_supported", "gap_evidenced", "insufficient_evidence", "human_validation_required"] },
            "summary": { "type": "string", "maxLength": 600 },
            "confidence": { "enum": ["high", "medium", "low", "unavailable"] }
          }
        },
        "blocking": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "curability", "reason"],
          "properties": {
            "effect": { "enum": ["blocker", "conditional", "non_blocking", "undetermined"] },
            "curability": { "enum": ["curable", "not_curable", "undetermined", "not_applicable"] },
            "reason": { "type": "string", "maxLength": 600 }
          }
        },
        "evidence_state": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["presence", "review", "validity", "applicability", "compliance"],
          "properties": {
            "presence": { "enum": ["present", "absent", "unknown"] },
            "review": { "enum": ["reviewed", "partially_reviewed", "not_reviewed"] },
            "validity": { "enum": ["valid", "expired", "unknown", "not_applicable"] },
            "applicability": { "enum": ["applicable", "not_applicable", "unknown"] },
            "compliance": { "enum": ["supported_pending_human_review", "partially_supported_pending_human_review", "gap_evidenced_pending_human_review", "unknown"] }
          }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "source_type", "purpose"],
            "properties": {
              "ref": { "type": "string", "maxLength": 120 },
              "source_type": { "enum": ["tender_document", "company_evidence", "legal_corpus", "human_evidence", "objective_validation"] },
              "purpose": { "enum": ["requirement_basis", "company_capacity", "legal_basis", "commercial_context", "milestone_basis", "gap_basis"] }
            }
          }
        },
        "missing_evidence": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["missing_id", "evidence_class_id", "needed_source_type", "reason", "critical"],
            "properties": {
              "missing_id": { "type": "string", "maxLength": 120 },
              "evidence_class_id": { "type": ["string", "null"], "maxLength": 120 },
              "needed_source_type": { "enum": ["tender_document", "company_evidence", "legal_corpus", "human_evidence", "objective_validation"] },
              "reason": { "type": "string", "maxLength": 600 },
              "critical": { "type": "boolean" }
            }
          }
        },
        "commercial_impact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "summary", "dimension"],
          "properties": {
            "level": { "enum": ["critical", "high", "medium", "low", "unknown"] },
            "summary": { "type": "string", "maxLength": 600 },
            "dimension": { "enum": ["eligibility", "competitiveness", "delivery_capacity", "financial_exposure", "strategic_fit", "unknown"] }
          }
        },
        "legal_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "basis_refs", "summary", "human_legal_review_required"],
          "properties": {
            "status": { "enum": ["supported", "partially_supported", "unsupported", "not_verified", "not_applicable"] },
            "basis_refs": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 120 } },
            "summary": { "type": "string", "maxLength": 600 },
            "human_legal_review_required": { "type": "boolean" }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action_id", "action_type", "summary", "basis_unit_id", "suggested_role", "priority", "external_side_effect"],
            "properties": {
              "action_id": { "type": "string", "maxLength": 120 },
              "action_type": { "enum": ["obtain_evidence", "verify_validity", "validate_applicability", "remediate_gap", "estimate_delivery", "estimate_financial_exposure", "human_decision"] },
              "summary": { "type": "string", "maxLength": 600 },
              "basis_unit_id": { "type": ["string", "null"], "maxLength": 120 },
              "suggested_role": { "enum": ["tender_lead", "legal", "commercial", "technical", "financial", "operations", "management", "authorized_human"] },
              "priority": { "enum": ["critical", "high", "medium", "low"] },
              "external_side_effect": { "type": "boolean" }
            }
          }
        },
        "milestone": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "type", "at", "source_ref", "summary"],
          "properties": {
            "status": { "enum": ["verified", "unverified", "not_identified"] },
            "type": { "enum": ["submission_deadline", "clarification_deadline", "cure_deadline", "visit", "hearing", "execution_start", "execution_duration", "internal_review", "other", "none"] },
            "at": { "type": ["string", "null"] },
            "source_ref": { "type": ["string", "null"], "maxLength": 120 },
            "summary": { "type": "string", "maxLength": 600 }
          }
        },
        "escalation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "level", "reason"],
          "properties": {
            "required": { "type": "boolean" },
            "level": { "enum": ["role_review", "cross_functional", "committee", "management", "none"] },
            "reason": { "type": "string", "maxLength": 600 }
          }
        },
        "closure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "condition", "evidence_required"],
          "properties": {
            "status": { "enum": ["open", "evidence_satisfied", "human_confirmation_required"] },
            "condition": { "type": "string", "maxLength": 600 },
            "evidence_required": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 120 } }
          }
        },
        "human_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "status", "reason"],
          "properties": {
            "required": { "type": "boolean" },
            "status": { "type": "string" },
            "reason": { "type": "string", "maxLength": 600 }
          }
        }
      }
    }
  }
}
