{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siio.local/contracts/agents/AGT-003/v2-draft/opportunity-copilot.response.schema.json",
  "title": "AGT-003 opportunity copilot preview response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "capability_id",
    "correlation_id",
    "snapshot_id",
    "policy_version",
    "model",
    "generated_at",
    "brief"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0-draft.1"
    },
    "capability_id": {
      "const": "agt003.opportunity-copilot.preview"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "facts",
        "inferences",
        "missing_information",
        "contact_objective",
        "strategy",
        "draft",
        "recommended_asset_ids",
        "warnings",
        "human_review_required"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "facts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "evidence_refs"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "inferences": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "evidence_refs",
              "confidence"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        },
        "missing_information": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "contact_objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "body"
          ],
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          }
        },
        "recommended_asset_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "human_review_required": {
          "const": true
        }
      }
    }
  }
}
