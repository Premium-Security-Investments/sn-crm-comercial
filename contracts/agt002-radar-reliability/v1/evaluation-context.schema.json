{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://contracts/agt002-radar-reliability/v1/evaluation-context.schema.json",
  "title": "AGT-002 M1 radar reliability evaluation context",
  "description": "Contexto de evaluación que compone el bundle completo (referencia promotion-bundle.schema.json) junto con el resultado de evaluación por término, en espejo de validateAgt002M1RadarReliabilityBundle.",
  "type": "object",
  "required": ["schema_version", "run_id", "bundle", "evaluation"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "agt002-m1-radar-reliability-v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "bundle": { "$ref": "repo://contracts/agt002-radar-reliability/v1/promotion-bundle.schema.json" },
    "evaluation": { "$ref": "#/$defs/evaluation_result" }
  },
  "$defs": {
    "evaluation_result": {
      "type": "object",
      "required": ["verdict", "promotable", "reasons", "checked_terms"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "$ref": "#/$defs/verdict" },
        "promotable": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason" }
        },
        "checked_terms": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/term_result" }
        }
      }
    },
    "term_result": {
      "type": "object",
      "required": ["term", "verdict", "reasons"],
      "additionalProperties": false,
      "properties": {
        "term": { "$ref": "#/$defs/term" },
        "verdict": { "$ref": "#/$defs/verdict" },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason" }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["VALID", "UNVERIFIED", "INVALID"]
    },
    "term": {
      "type": "string",
      "enum": [
        "schema",
        "terminal_state",
        "temporal_integrity",
        "coverage",
        "freshness",
        "evidence",
        "traceability"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "schema.additional_property",
        "schema.missing_property",
        "schema.invalid_type",
        "schema.invalid_id",
        "schema.invalid_hash",
        "scan.status.invalid",
        "scan.status.failed",
        "scan.status.not_terminal",
        "temporal.timestamp_format_invalid",
        "temporal.timestamp_invalid",
        "temporal.order_invalid",
        "coverage.partial",
        "coverage.first_page_claims_absence",
        "coverage.pagination_invalid",
        "freshness.stale",
        "freshness.invalid",
        "evidence.absent",
        "evidence.duplicate_id",
        "evidence.invalid_locator",
        "traceability.source_persistence_mismatch",
        "traceability.persistence_ui_mismatch"
      ]
    }
  }
}
