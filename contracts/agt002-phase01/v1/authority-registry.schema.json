{
  "$id": "https://seguridadnacional.internal/contracts/agt002-phase01/v1/authority-registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "supersedes_registry_version", "issued_at_utc", "grants"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agt002-phase01-authority-registry/1.0.0"
    },
    "registry_version": {
      "type": "number"
    },
    "supersedes_registry_version": {
      "type": ["number", "null"]
    },
    "issued_at_utc": {
      "type": "string"
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "gate_type",
          "principal",
          "delegate_of",
          "valid_from_utc",
          "valid_until_utc",
          "scope",
          "revoked_at_utc"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "pattern": "^GRANT-[A-Z0-9-]{4,48}$"
          },
          "gate_type": {
            "type": "string",
            "enum": [
              "PHASE_AUDIT",
              "LINK_VERIFICATION",
              "AUTHORITY_DELEGATION",
              "STORAGE_DESIGN_REVIEW",
              "PRODUCTION_ACTION"
            ]
          },
          "principal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["principal_id", "principal_kind", "durable_ref", "display_label"],
            "properties": {
              "principal_id": { "type": "string" },
              "principal_kind": {
                "type": "string",
                "enum": ["human", "agent", "synthetic"]
              },
              "durable_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "locator", "verifiable"],
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": ["psi_sales_profiles", "agent_identity", "fixture_registry"]
                  },
                  "locator": { "type": "string" },
                  "verifiable": { "type": "boolean" }
                }
              },
              "display_label": { "type": "string" }
            }
          },
          "delegate_of": {
            "type": ["string", "null"],
            "pattern": "^GRANT-[A-Z0-9-]{4,48}$"
          },
          "valid_from_utc": { "type": "string" },
          "valid_until_utc": { "type": "string" },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["environments", "resource_kind", "resource_ids", "actions"],
            "properties": {
              "environments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": ["production", "isolated_fixture"]
                }
              },
              "resource_kind": { "type": "string" },
              "resource_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string" }
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            }
          },
          "revoked_at_utc": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
