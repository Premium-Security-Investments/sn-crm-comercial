{
  "$id": "https://seguridadnacional.internal/contracts/agt002-phase01/v1/valid-link-claim.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "terms",
    "source_id",
    "target_id",
    "tender_process_ref",
    "conversion_decision_id",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agt002-phase01-valid-link-claim/1.0.0"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^CLAIM-[A-Z0-9-]{3,64}$"
    },
    "terms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "binding_registered",
          "query_exhaustive",
          "authoritative_source",
          "cardinality_exactly_one",
          "identity_no_conflict",
          "state_live",
          "opportunity_open",
          "evidence_durable",
          "term_a_entity_l",
          "term_b_logical",
          "conversion_decision_valid",
          "no_incompatible_link"
        ]
      }
    },
    "source_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "tender_process_ref": {
      "type": "string",
      "minLength": 1
    },
    "conversion_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "term_a": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimed_entity": {
          "type": "string"
        }
      }
    },
    "term_b": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "forward",
            "inverse"
          ]
        },
        "claimed_table": {
          "type": "string"
        },
        "claimed_column": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "kind",
          "locator",
          "durable",
          "content_hash",
          "captured_at_utc"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "repo_file",
              "migration_locator",
              "openapi_metadata",
              "fixture_record"
            ]
          },
          "locator": {
            "type": "string",
            "pattern": "^(?:repo|migration|fixture|evidence)://[A-Za-z0-9._/-]+$"
          },
          "durable": {
            "type": "boolean"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "captured_at_utc": {
            "type": "string",
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
          }
        }
      }
    }
  }
}
