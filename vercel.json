{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/tender-processing-worker-run", "schedule": "* * * * *" }
  ]
}
