NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
PORT=4173

# AGT-002 production deploy readback (public endpoint; not a secret).
# For a manually authorized deploy, pass this variable explicitly on the same invocation of
# scripts/agt002-deploy-vercel-production.sh. Do not rely on implicit shell state.
AGT002_VERCEL_PRODUCTION_CONTROL_PLANE_URL=https://seguridad-nacional-crm.vercel.app/api/agt002/control-plane

# AGT-002 INITIAL — server/worker only. Both switches remain false until a separate deploy and
# canary gate. Values shown are examples, not an authorization to install the timer or migrate.
AGT002_INITIAL_ANALYSIS_ADMISSION_ENABLED=false
AGT002_MODEL_CALLS_ENABLED=false
AGT002_INITIAL_ANALYSIS_RUNTIME_IDENTITY=agt002-initial-analysis-worker
AGT002_INITIAL_ANALYSIS_MODEL_ID=YOUR_APPROVED_MODEL
AGT002_INITIAL_ANALYSIS_MAX_TOTAL_TOKENS=12000
AGT002_INITIAL_ANALYSIS_MAX_COST_USD=10
AGT002_INITIAL_ANALYSIS_TIMEOUT_MS=30000
AGT002_INITIAL_ANALYSIS_REASONING_EFFORT=medium
AGT002_INITIAL_ANALYSIS_INPUT_COST_PER_MILLION_USD=REPLACE_ME
AGT002_INITIAL_ANALYSIS_OUTPUT_COST_PER_MILLION_USD=REPLACE_ME
AGT002_BRIDGE_HMAC_SECRET=YOUR_SERVER_ONLY_SIGNING_SECRET

# Vig-IA opportunity copilot — server only; disabled until rollout gates are approved.
AGT003_COPILOT_ENGINE=disabled
AGT003_COPILOT_BRIDGE_URL=https://YOUR_AGENT_BRIDGE_HOST/v1/agt003-copilot/run
AGT003_COPILOT_HMAC_SECRET=YOUR_SERVER_ONLY_SIGNING_SECRET
# Use agt003 for a dedicated bridge. Temporary reuse of the governed AGT-002 transport must be explicit.
AGT003_COPILOT_WIRE_PROTOCOL=agt003
AGT003_COPILOT_MODEL=YOUR_APPROVED_MODEL
AGT003_COPILOT_POLICY_VERSION=agt003-opportunity-copilot-v1
AGT003_COPILOT_TIMEOUT_MS=30000
AGT003_COPILOT_MAX_CONCURRENT=2
AGT003_COPILOT_DAILY_MAX_RUNS=20
AGT003_COPILOT_CLAIM_LEASE_SECONDS=45
