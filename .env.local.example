NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
PORT=4173

# Vig-IA opportunity copilot — server only; disabled until rollout gates are approved.
AGT003_COPILOT_ENGINE=disabled
AGT003_COPILOT_BRIDGE_URL=https://YOUR_AGENT_BRIDGE_HOST/v1/agt003-copilot/run
AGT003_COPILOT_HMAC_SECRET=YOUR_SERVER_ONLY_SIGNING_SECRET
# Use agt003 for a dedicated bridge. Temporary reuse of the governed AGT-002 transport must be explicit.
AGT003_COPILOT_WIRE_PROTOCOL=agt003
AGT003_COPILOT_MODEL=YOUR_APPROVED_MODEL
AGT003_COPILOT_POLICY_VERSION=agt003-opportunity-copilot-v1
AGT003_COPILOT_TIMEOUT_MS=30000
AGT003_COPILOT_MAX_CONCURRENT=2
AGT003_COPILOT_DAILY_MAX_RUNS=20
AGT003_COPILOT_CLAIM_LEASE_SECONDS=45
