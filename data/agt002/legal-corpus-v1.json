    },
    {
      "source_id": "decreto-356-1994-art-7",
      "norm_type": "decreto_ley",
      "norm_number": "356",
      "year": 1994,
      "article_or_section": "Artículo 7",
      "current_text": "ARTÍCULO 7.- Control. La Superintendencia de Vigilancia y Seguridad Privada ejercerá control, inspección y vigilancia sobre todas las personas naturales o jurídicas que desarrollen actividades de vigilancia y seguridad privada y sus usuarios de conformidad con lo establecido en la ley.",
      "issuing_authority": "Presidencia de la República",
      "issued_at": "1994-02-11",
