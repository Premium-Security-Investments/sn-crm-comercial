# Plantilla del EnvironmentFile del puente AGT-002.
# Copiar a /etc/agt002-bridge/agt002-bridge.env con propietario root:agt002-bridge y modo 0640.
# Esta plantilla nunca debe contener valores reales: los secretos se escriben
# sólo en el archivo del servidor, jamás en el repositorio.
#
# El puente no recibe ninguna credencial de proveedor por entorno. El turno se
# autentica exclusivamente con la sesión OAuth de Claude Code que vive en
# CLAUDE_CONFIG_DIR (fijado por la unidad systemd) y que se renueva a mano.
AGT002_BRIDGE_HMAC_SECRET=
AGT002_BRIDGE_LISTEN_PORT=8787
AGT002_BRIDGE_HOST=agt002.5-78-140-24.sslip.io

# Allowlist de modelos, separada por comas y con coincidencia exacta. El
# puente decide qué modelos existen: nada fuera de esta lista llega al argv
# del proveedor.
AGT002_BRIDGE_ALLOWED_MODELS=sonnet

# Binario del CLI de Claude Code a invocar. Por defecto "claude" (resuelto por
# PATH); se puede fijar a una ruta absoluta si el servicio no hereda el PATH
# donde está instalado.
AGT002_CLAUDE_CLI_BIN=claude

# El servidor de AGT-002 no impone un techo propio al timeoutMs de la
# petición (a diferencia de AGT-003): los jobs actuales piden hasta
# timeout_ms=285000. Si en el futuro se introduce un techo explícito, debe
# quedar en al menos 300000 para no rechazar esos jobs con 400.
