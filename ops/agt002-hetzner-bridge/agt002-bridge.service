# Revisar y aplicar manualmente en Hetzner durante la Tarea 14 (Fase 1). No aplicado por este plan.
[Unit]
Description=AGT-002 Hetzner bridge (temporary, 30-day bridge)
After=network.target

[Service]
Type=simple
User=agt002-bridge
Group=agt002-bridge
EnvironmentFile=/etc/agt002-bridge/agt002-bridge.env
# La sesión OAuth de Claude Code vive en un directorio propio bajo /opt y no en
# $HOME: con ProtectHome=true cualquier credencial ubicada en $HOME sería
# ilegible para el servicio.
Environment=CLAUDE_CONFIG_DIR=/opt/agt002-bridge/.claude
# `claude` y sus dependencias escriben en $HOME aunque CLAUDE_CONFIG_DIR esté
# fijado. Con ProtectHome=true un HOME heredado (o vacío) haría fallar el spawn
# con un error de escritura inútil: HOME apunta al mismo directorio del
# servicio que ya está en ReadWritePaths.
Environment=HOME=/opt/agt002-bridge
ExecStart=/usr/bin/node /opt/agt002-bridge/ops/agt002-hetzner-bridge/run-server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/agt002-bridge/.claude /opt/agt002-bridge/var
CPUQuota=100%
# Un turno del proveedor con salida larga sostiene picos por encima de 512 MiB;
# con el techo anterior el OOM killer mataría el subproceso a media respuesta y
# el llamador recibiría un fallo indistinguible de un error del modelo.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
