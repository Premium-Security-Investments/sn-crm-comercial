[Unit]
Description=SIIO AGT-002 durable initial-analysis worker
Wants=network-online.target
After=network-online.target
# Un solo reloj para el análisis (Juan, 2026-11-11): cada corrida arranca primero la admisión automática
# (documentos, OCR, primeros análisis y "Volver a analizar"), espera a que termine y después ejecuta lo admitido.
# Cada paso sigue siendo su propia unidad, con su usuario y su entorno; si la admisión falla, el worker corre igual.
Wants=agt002-auto-initial.service
After=agt002-auto-initial.service

[Service]
Type=oneshot
User=psi-agt002
Group=psi-agt002
WorkingDirectory=/opt/psi-comercial/app
EnvironmentFile=/etc/psi-agt002-initial-analysis/env
ExecStart=/usr/bin/node /opt/psi-comercial/app/ops/agt002-initial-analysis-worker/run-agt002-initial-analysis-worker.mjs
TimeoutStartSec=660
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
