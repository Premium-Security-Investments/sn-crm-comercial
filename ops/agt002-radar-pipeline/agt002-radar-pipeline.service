[Unit]
Description=AGT-002 Radar one-shot preanalysis pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/psi-comercial/agt002-radar-pipeline.env
WorkingDirectory=/opt/psi-comercial/app
ExecStart=/usr/bin/node /opt/psi-comercial/app/ops/agt002-radar-pipeline/run-agt002-radar-pipeline.mjs
User=psi-comercial
Group=psi-comercial
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
TimeoutStartSec=720
