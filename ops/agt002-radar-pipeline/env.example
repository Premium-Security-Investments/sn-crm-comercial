# Timeout del proveedor por corrida, en ms. Rango aceptado: 1000..300000 (5 min).
# Fuera de rango la configuración falla cerrado; no se recorta en silencio.
# Recomendado en produccion: 30000. El techo de 300000 deja >=300 s de holgura bajo el
# lease de 600 s con el que el pipeline reclama el job (aprendizaje, validacion y persistencia).
AGT002_RADAR_PREANALYSIS_TIMEOUT_MS=30000
