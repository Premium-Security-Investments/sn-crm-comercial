# Artefacto declarativo AGT-003: revisar y aplicar manualmente. No aplicado por este cambio.
# Host canónico: AGT003_BRIDGE_HOST=agt003.5-78-140-24.sslip.io.
# Si el DNS efectivo exige la forma con puntos, usar explícitamente
# AGT003_BRIDGE_HOST=agt003.5.78.140.24.sslip.io y regenerar/revisar este vhost
# antes de aplicarlo.
agt003.5-78-140-24.sslip.io {
	# El cuerpo excesivo se corta en el borde, antes de reenviarlo: si el límite
	# viviera sólo en el puente, cada cuerpo enorme se transferiría entero por el
	# loopback para acabar rechazado con 413 de todas formas. Mismo techo que el
	# puente: 1 MiB.
	request_body {
		max_size 1MiB
	}
	reverse_proxy 127.0.0.1:8788
}
