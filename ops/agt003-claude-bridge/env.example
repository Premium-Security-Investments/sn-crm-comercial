# Plantilla del EnvironmentFile del puente dedicado AGT-003.
# Copiar a /etc/agt003-bridge/agt003-bridge.env con propietario root:agt003-bridge y modo 0640.
# Esta plantilla nunca debe contener valores reales: los secretos se escriben
# sólo en el archivo del servidor, jamás en el repositorio.
#
# El puente no recibe ninguna credencial de proveedor por entorno. El turno se
# autentica exclusivamente con la sesión OAuth de Claude Code que vive en
# CLAUDE_CONFIG_DIR (fijado por la unidad systemd) y que se renueva a mano
# siguiendo el procedimiento documentado en README.md.
AGT003_BRIDGE_HMAC_SECRET=
AGT003_BRIDGE_LISTEN_PORT=8788
AGT003_BRIDGE_HOST=agt003.5-78-140-24.sslip.io

# Techos operativos. Se cambian aquí, nunca en el código ni por petición.
# Turnos simultáneos del proveedor. La máquina de 2 vCPU sostiene uno solo:
# el turno que sobra se rechaza con 429 AGT003_BRIDGE_BUSY sin lanzar proceso.
AGT003_BRIDGE_MAX_CONCURRENCY=1
# Techo del timeoutMs que puede pedir la petición. Por encima: 400, sin recorte.
AGT003_BRIDGE_MAX_TIMEOUT_MS=120000
# Allowlist de modelos, separada por comas y con coincidencia exacta.
AGT003_BRIDGE_ALLOWED_MODELS=sonnet

# Techos de socket. Acotan lo que un cliente puede retener del proceso *antes*
# de que exista un turno, para que nadie agote los descriptores del puente
# abriendo conexiones ociosas. Se cambian aquí, nunca en el código.
# Conexiones simultáneas admitidas; por encima el socket se cierra al aceptar.
AGT003_BRIDGE_MAX_CONNECTIONS=16
# Plazo para recibir las cabeceras completas de una petición.
AGT003_BRIDGE_HEADERS_TIMEOUT_MS=10000
# Plazo para recibir la petición completa, cabeceras y cuerpo incluidos.
AGT003_BRIDGE_REQUEST_TIMEOUT_MS=15000
