# Copiar a /etc/psi-agt002-reanalysis/env con propietario root:psi-agt002 y modo 0640.
# Valores reales: Supabase productivo y el mismo cliente HMAC del bridge usado por Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AGT002_HETZNER_BRIDGE_URL=
AGT002_HETZNER_BRIDGE_HMAC_SECRET=
# Puerto exclusivo de R1; 8788 pertenece al puente dedicado AGT-003.
AGT002_INCREMENTAL_DISPATCH_LISTEN_PORT=8789
# Vacío para el timer normal. Sólo una ejecución de recuperación autorizada puede fijar
# el UUID exacto de su nuevo job; ese job queda excluido de la cola normal.
AGT002_REANALYSIS_TARGET_JOB_ID=
