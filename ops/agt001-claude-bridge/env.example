# Plantilla de /etc/agt001-bridge/agt001-bridge.env (root:agt001-bridge, 0640). Sin valores reales en el repositorio.
# El servidor reutiliza run-server.mjs del puente AGT-003, por eso las variables conservan el prefijo AGT003_.
AGT003_BRIDGE_HMAC_SECRET=
AGT003_BRIDGE_LISTEN_PORT=8789
AGT003_BRIDGE_HOST=agt001.5-78-140-24.sslip.io
AGT003_CLAUDE_BIN=/usr/bin/claude
AGT003_CLAUDE_CWD=/opt/agt001-bridge/var
AGT003_BRIDGE_MAX_CONCURRENCY=1
AGT003_BRIDGE_MAX_TIMEOUT_MS=120000
AGT003_BRIDGE_ALLOWED_MODELS=sonnet
AGT003_BRIDGE_MAX_CONNECTIONS=16
AGT003_BRIDGE_HEADERS_TIMEOUT_MS=10000
AGT003_BRIDGE_REQUEST_TIMEOUT_MS=15000
