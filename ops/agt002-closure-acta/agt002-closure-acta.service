[Unit]
Description=AGT-002 closure minutes (acta de cierre): Vig-IA drafts from the closing note the person wrote
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# PENDIENTE DE CONFIRMAR CON OPS: este servicio necesita dos cosas que hoy viven en archivos de entorno
# distintos y con dueños distintos — el de Supabase (el mismo del análisis automático, usuario psi-agt002) y
# el del puente de la Mesa (modo 0640, de root:agt002-workbench-scheduler). Hay que decidir si psi-agt002
# puede leer el segundo, o si el servicio corre con otra identidad. Sin esa decisión, NO instalar.
User=psi-agt002
Group=psi-agt002
EnvironmentFile=/etc/psi-agt002-initial-analysis/env
EnvironmentFile=/etc/agt002-workbench-scheduler/env
UMask=0022
# Cuántas actas como máximo por corrida; cada una es una llamada al modelo.
Environment=AGT002_CLOSURE_ACTA_MAX_PER_RUN=5
# Release path is set by the deploy drop-in (10-release.conf).
WorkingDirectory=/opt/psi-comercial/app
ExecStart=/usr/bin/node /opt/psi-comercial/app/ops/agt002-radar-daily/run-agt002-radar-import.mjs --closure-acta
TimeoutStartSec=10min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
