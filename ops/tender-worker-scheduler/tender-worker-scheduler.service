[Unit]
Description=SIIO durable tender worker scheduler
Documentation=https://github.com/Premium-Security-Investments/sn-crm-comercial
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=tender-worker-scheduler
Group=tender-worker-scheduler
EnvironmentFile=/etc/tender-worker-scheduler/env
ExecStart=/opt/tender-worker-scheduler/run-tender-worker.sh
TimeoutStartSec=130s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
